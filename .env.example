# App
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_ECHO=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-frontend.onrender.com

# Gemini speech-to-text
GEMINI_API_KEY=your_gemini_api_key
GEMINI_TRANSCRIBE_MODEL=gemini-2.5-flash
GEMINI_API_BASE=https://generativelanguage.googleapis.com

# NVIDIA NIM reasoning
NVIDIA_NIM_API_KEY=your_nvidia_nim_api_key
NVIDIA_NIM_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_NIM_API_BASE=https://integrate.api.nvidia.com
NIM_LIVE_SCORE_RETRIES=2
NIM_TIMEOUT_SECONDS=20
